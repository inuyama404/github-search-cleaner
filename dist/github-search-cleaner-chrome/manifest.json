{
  "manifest_version": 3,
  "name": "GitHub 搜索记录清理器",
  "short_name": "GH 搜索清理",
  "version": "1.0.0",
  "description": "隐藏并清理 GitHub 搜索框中的“最近搜索”，清除本地搜索记录和相关 Cookie，不发送任何网络请求。",
  "permissions": ["storage", "cookies"],
  "host_permissions": ["https://github.com/*"],
  "action": {
    "default_title": "GitHub 搜索记录清理器",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
